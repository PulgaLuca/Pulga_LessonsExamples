<UserControl x:Class="BlaisePascal.LessonsExamples.WpfUI.Views.LampView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <materialDesign:Card Padding="10" Margin="5">
            <StackPanel>
                <TextBlock Text="Lamps Management" FontSize="22" FontWeight="Bold" Margin="5"/>
                <ListBox x:Name="LampList" Margin="5" Height="500">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="5" Padding="10" Background="#F5F5F5">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Status}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Intensity: "/>
                                        <TextBlock Text="{Binding Brightness}"/>
                                    </StackPanel>
                                </StackPanel>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </materialDesign:Card>

        <StackPanel Grid.Column="1">
            <materialDesign:Card Margin="5" Padding="15">
                <StackPanel>
                    <TextBlock Text="New Lamp" FontSize="18" FontWeight="Bold"/>
                    <TextBox x:Name="NewLampNameTextBox" materialDesign:HintAssist.Hint="Lamp Name" Margin="0,10,0,0"/>
                    <TextBox x:Name="NewLampIntensityTextBox" materialDesign:HintAssist.Hint="Initial Intensity" Margin="0,10,0,10"/>
                    <Button Content="Add Lamp" Click="Add_Click" Background="#1976D2" Foreground="White"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="5" Padding="15">
                <StackPanel>
                    <TextBlock Text="Controls" FontSize="18" FontWeight="Bold"/>
                    <Button Content="Switch ON" Click="On_Click" Margin="0,10,0,0" Background="#2196F3" Foreground="White"/>
                    <Button Content="Switch OFF" Click="Off_Click" Margin="0,5,0,0" Background="#2196F3" Foreground="White"/>
                    <TextBox x:Name="IntensityTextBox" materialDesign:HintAssist.Hint="Set Intensity" Margin="0,15,0,5"/>
                    <Button Content="Apply Intensity" Click="Intensity_Click" Margin="0,5,0,0" Background="Green" Foreground="White"/>
                    <Button Content="Remove Lamp" Click="Remove_Click" Margin="0,20,0,0" Background="#E53935" Foreground="White"/>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </Grid>
</UserControl>